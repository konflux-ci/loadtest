# StoneSoupLoadTestProbe_lightwell_dev_LWPython.groovy / runKonfluxProbeTest defaults.
# Source from ci-scripts/run-probe/run-lwpython-probe-local.sh or manually:
#   set -a; source ci-scripts/run-probe/scenarios/lightwell-dev-lwpython.env; set +a

CLUSTER=lightwell-dev
NAMESPACE=konflux-perfscale-3-tenant
SERVER_API_URL=https://c111-e.us-east.containers.cloud.ibm.com:32325/

# Jenkins uses rhtap-perf-test + vault bot token; local dev often uses test-probe + personal token.
COMPONENT_REPO=https://github.com/rhtap-perf-test/lw-pypi.org-ntplib-1
COMPONENT_REPO_REVISION=main
MY_GITHUB_ORG=rhtap-perf-test

LOGGING_LEVEL=debug
RUN_PREFIX=pslwdpy

PIPELINE_REPO_TEMPLATING=true
PIPELINE_REPO_TEMPLATING_SOURCE=https://github.com/rhtap-perf-test/konflux-probe-test-templates
PIPELINE_REPO_TEMPLATING_SOURCE_DIR=lightwell-dev-LWPython

# Disable integration test scenario (empty git URL).
TEST_SCENARIO_GIT_URL=
TEST_SCENARIO_PATH_IN_REPO=
TEST_SCENARIO_REVISION=main

WAIT_INTEGRATION_TESTS=false
WAIT_PIPELINES=true
WAIT_RELEASE=false
RELEASE_POLICY=

OCI_STORAGE=quay.io/rhtap-perf-test/perf-release-service-trusted-artifacts-stage
QUAY_REPO=redhat-user-workloads-stage

APPLICATIONS_COUNT=1
COMPONENTS_COUNT=1
CONCURRENCY=1
OUTPUT_DIR=.
PURGE=true
PURGE_ONLY=false
